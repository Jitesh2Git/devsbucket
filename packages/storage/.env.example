# Local dev. Copy to packages/storage/.env and fill in real values. Never commit .env.
# Used by `pnpm storage:setup` and `pnpm storage:check`.

# Garage (docker/compose.dev.yml). Key, secret and bucket: the S3_* values in docker/.env.
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=devsbucket
S3_ACCESS_KEY_ID=GK000000000000000000000000
S3_SECRET_ACCESS_KEY=change-me

# Pages allowed to upload straight to the bucket: `pnpm dev` and the e2e server.
S3_CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# Operations are counted in Postgres. Same value as packages/db/.env.
DATABASE_URL=postgres://devsbucket:change-me@localhost:5432/devsbucket