# Local dev. Copy to apps/worker/.env and fill in real values. Never commit .env.
# The same values as apps/web/.env.local: the worker uses the same database
# and storage as the web app.
DATABASE_URL=postgres://devsbucket:change-me@localhost:5432/devsbucket

# Garage (docker/compose.dev.yml). Key, secret and bucket: the S3_* values in docker/.env.
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=devsbucket
S3_ACCESS_KEY_ID=GK000000000000000000000000
S3_SECRET_ACCESS_KEY=change-me