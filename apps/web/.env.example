# Local dev. Copy to apps/web/.env.local and fill in real values. Never commit .env.local.

# Same value as packages/db/.env (password from docker/.env).
DATABASE_URL=postgres://devsbucket:change-me@localhost:5432/devsbucket

# Signs session cookies and tokens. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# Where the app runs. Better Auth uses it for redirects and to check request origins.
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth app for local dev (github.com → Settings → Developer settings → OAuth Apps).
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=change-me
GITHUB_CLIENT_SECRET=change-me