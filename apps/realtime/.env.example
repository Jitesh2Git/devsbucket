# Local dev. Copy to apps/realtime/.env. Never commit .env.
# The same database as apps/web/.env.local.
DATABASE_URL=postgres://devsbucket:change-me@localhost:5432/devsbucket

# The web app: its pages are the only ones allowed to connect, and it
# answers "who is this cookie?" (Better Auth).
WEB_URL=http://localhost:3000

# Where browsers connect (NEXT_PUBLIC_REALTIME_URL in apps/web/.env.local).
PORT=3001