# The production stack on the Mac (docker/compose.prodlike.yml), with its
# own database and Garage. Copy to docker/.env.prodlike and fill in:
#   cp docker/.env.prodlike.example docker/.env.prodlike
# Never commit docker/.env.prodlike (it is in .gitignore).

DEVSBUCKET_DOMAIN=localhost
DEVSBUCKET_TAG=local

# Letters and digits only (it goes into a URL): openssl rand -hex 32
POSTGRES_USER=devsbucket
POSTGRES_PASSWORD=change-me
POSTGRES_DB=devsbucket

# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# GitHub login isn't tried here (the local OAuth app's callback is
# localhost:3000); any value works.
GITHUB_CLIENT_ID=unused
GITHUB_CLIENT_SECRET=unused

# This stack's own Garage. Generate the values with:
#   GARAGE_RPC_SECRET:     openssl rand -hex 32
#   S3_ACCESS_KEY_ID:      echo "GK$(openssl rand -hex 12)"
#   S3_SECRET_ACCESS_KEY:  openssl rand -hex 32
GARAGE_RPC_SECRET=change-me
S3_ENDPOINT=http://garage.localhost:3910
S3_REGION=garage
S3_BUCKET=devsbucket
S3_ACCESS_KEY_ID=GK000000000000000000000000
S3_SECRET_ACCESS_KEY=change-me