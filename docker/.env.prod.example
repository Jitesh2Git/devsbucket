# Production settings (Phase 6). On the server only, as /opt/devsbucket/.env
# (mode 600, owned by deploy), filled in by hand there. Never committed,
# never in GitHub: prod secrets stay on the server (LOCKED.md).

# The public address (DuckDNS) and the images to run (a commit SHA; the
# deploy script sets it).
DEVSBUCKET_DOMAIN=devsbucket.duckdns.org
DEVSBUCKET_TAG=main

# Postgres. The password goes into a URL, so letters and digits only:
#   openssl rand -hex 32
POSTGRES_USER=devsbucket
POSTGRES_PASSWORD=change-me
POSTGRES_DB=devsbucket

# Better Auth. Changing the secret signs everyone out:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# The prod GitHub OAuth app (its own, not the local one). Callback URL:
#   https://devsbucket.duckdns.org/api/auth/callback/github
GITHUB_CLIENT_ID=change-me
GITHUB_CLIENT_SECRET=change-me

# Cloudflare R2: a private bucket and an API token limited to it (object
# read and write). The endpoint is the account's S3 address.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=devsbucket
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me