# Local dev only. Copy to docker/.env and fill in real values:
#   cp docker/.env.example docker/.env
# Never commit docker/.env (it is in .gitignore).

# Postgres
POSTGRES_USER=devsbucket
POSTGRES_PASSWORD=change-me
POSTGRES_DB=devsbucket

# Garage (local S3). Generate the values with:
#   GARAGE_RPC_SECRET:     openssl rand -hex 32
#   S3_ACCESS_KEY_ID:      echo "GK$(openssl rand -hex 12)"
#   S3_SECRET_ACCESS_KEY:  openssl rand -hex 32
GARAGE_RPC_SECRET=change-me
S3_ACCESS_KEY_ID=GK000000000000000000000000
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET=devsbucket